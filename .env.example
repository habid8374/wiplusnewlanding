# ─────────────────────────────────────────────────────────────
# WIPLUS Comunicaciones — variables de entorno
# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en Cloudflare (wrangler secret put / panel) o Vercel.
# Ninguna es obligatoria para compilar: sin ellas el sitio usa el
# contenido local de /content y los formularios responden en modo simulado.
# ─────────────────────────────────────────────────────────────

# URL pública canónica (sin barra final)
NEXT_PUBLIC_SITE_URL=https://www.wiplus.com.co

# WhatsApp (solo dígitos, con indicativo 57). TODO(WIPLUS): confirmar número.
NEXT_PUBLIC_WHATSAPP_NUMBER=573012133151

# ── Sanity CMS ───────────────────────────────────────────────
# Si NEXT_PUBLIC_SANITY_PROJECT_ID está vacío, el sitio lee de /content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Token de solo lectura (opcional, solo si el dataset es privado)
SANITY_API_READ_TOKEN=
# Token de ESCRITURA (Editor), solo servidor: guarda las solicitudes del verificador de cobertura
# en CMS › Cobertura › Solicitudes. Sin él, las solicitudes solo llegan por correo.
SANITY_WRITE_TOKEN=
# Secreto compartido con el webhook de Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Correo de los formularios (Brevo o Resend; si están las dos, se usa Brevo) ──
# Brevo: brevo.com › SMTP & API › API Keys
BREVO_API_KEY=
# Resend (alternativa)
RESEND_API_KEY=
# Remitente verificado en Brevo/Resend (idealmente con el dominio wiplus.com.co autenticado)
MAIL_FROM="WIPLUS Comunicaciones <no-responder@wiplus.com.co>"
# Destino de los formularios
MAIL_TO=atencionalcliente@wiplus.com.co

# ── Cloudflare Turnstile (antispam) ──────────────────────────
# Claves de prueba de Cloudflare: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Analytics 4 ───────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# Entorno del sitio. En el despliegue real usar "production":
#  - se oculta el contenido marcado como [EJEMPLO] (testimonios, barrios, etc. de relleno)
#  - robots.txt permite indexar y se publica el sitemap
#  - los formularios exigen BREVO_API_KEY o RESEND_API_KEY (sin ella piden usar WhatsApp)
# Cualquier otro valor = entorno de pruebas: se ve [EJEMPLO] y no se indexa.
# En Vercel déjalo VACÍO: se usa NEXT_PUBLIC_VERCEL_ENV (solo Production se indexa; las previews no).
NEXT_PUBLIC_SITE_ENV=

# ── Google Search Console / Bing (verificación por etiqueta HTML, opcional) ──
# Solo el valor de "content" de la etiqueta <meta name="google-site-verification" content="...">
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
